# Normalize all text files to LF across Windows and Mac (overrides core.autocrlf)
* text=auto eol=lf

# Web frontend & config files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf

# Unity C# scripts & YAML scene/asset files
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asset text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.playable text eol=lf
*.mask text eol=lf
*.renderTexture text eol=lf
*.spriteatlas text eol=lf
*.mixer text eol=lf

# Keep Unity .meta files tracked as LF text so asset GUIDs never break
*.meta text eol=lf

# Binary assets (prevent Git from altering line endings or corrupting files)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.psd binary
*.tga binary
*.fbx binary
*.obj binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.zip binary